generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserTipo {
  comum
  organizador
  admin
  moderador
  empresa
}

enum TipoInteracao {
  visualizacao
  favorito
  como_chegar
  ingresso
}

enum FaixaEtaria {
  ate_17
  de_18_a_24
  de_25_a_34
  de_35_a_44
  de_45_a_54
  de_55_ou_mais
}

enum TipoDocumento {
  CPF
  CNPJ
}

enum StatusVerificacao {
  pendente
  aprovado
  rejeitado
}

enum EventFonte {
  interno
  ticketmaster
  mapas_culturais
}

enum RestricaoIdade {
  livre
  doze
  quatorze
  dezesseis
  dezoito
}

enum EventStatus {
  rascunho
  publicado
  cancelado
  adiado
  em_revisao
  /// Veio de fonte externa (Mapas Culturais) e está no ar sem revisão da equipe.
  importado
  /// Sumiu da fonte ou a última ocorrência já passou; volta a `importado` se reaparecer.
  inativo
}

enum RevisaoResultado {
  recusado
  ajuste
}

enum DenunciaMotivo {
  falso
  improprio
  ja_aconteceu
  outro
}

enum DenunciaStatus {
  aberta
  descartada
  resolvida
}

enum AdSlotTipo {
  banner_home
  banner_categoria
  destaque_evento
}

model User {
  id                  String    @id @default(cuid())
  nome                String
  email               String    @unique
  senhaHash           String?   @map("senha_hash")
  tipo                UserTipo  @default(comum)
  interesses          String[]
  dataNascimento      DateTime? @map("data_nascimento")
  aceitePrivacidadeEm DateTime? @map("aceite_privacidade_em")
  criadoEm            DateTime  @default(now()) @map("criado_em")
  suspensoEm          DateTime? @map("suspenso_em")

  organizer           Organizer?
  favorites           Favorite[]
  comments            Comment[]
  commentReports      CommentReport[]
  adminLogs           AdminLog[]
  denuncias           Denuncia[]      @relation("denunciante")
  denunciasResolvidas Denuncia[]      @relation("resolvedor")
  empresa             Empresa?

  @@map("users")
}

model Organizer {
  id                String            @id @default(cuid())
  userId            String            @unique @map("user_id")
  nomeEmpresa       String            @map("nome_empresa")
  documento         String
  tipoDocumento     TipoDocumento     @map("tipo_documento")
  statusVerificacao StatusVerificacao @default(pendente) @map("status_verificacao")
  dataVerificacao   DateTime?         @map("data_verificacao")
  documentoUrl      String            @map("documento_url")
  /// Suspenso: eventos somem do site público até reativar.
  suspensoEm        DateTime?         @map("suspenso_em")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]

  @@map("organizers")
}

model Event {
  id                  String            @id @default(cuid())
  organizerId         String?           @map("organizer_id")
  fonte               EventFonte
  /// URL base da instância do Mapas Culturais; vazio nas outras fontes.
  fonteInstancia      String            @default("") @map("fonte_instancia")
  idExterno           String?           @map("id_externo")
  titulo              String
  descricao           String
  categoriaId         String?           @map("categoria_id")
  dataHora            DateTime          @map("data_hora")
  dataFim             DateTime?         @map("data_fim")
  endereco            String
  latitude            Float
  longitude           Float
  imagemCapa          String?           @map("imagem_capa")
  linkIngresso        String?           @map("link_ingresso")
  gratuito            Boolean           @default(false)
  tags                String[]
  restricaoIdade      RestricaoIdade    @map("restricao_idade")
  linkSaibaMais       String?           @map("link_saiba_mais")
  notaAdmin           String?           @map("nota_admin")
  status              EventStatus       @default(rascunho)
  destaque            Boolean           @default(false)
  /// Motivo de recusa ou pedido de ajuste da revisão; aparece para o organizador em /conta/eventos.
  mensagemOrganizador String?           @map("mensagem_organizador")
  revisaoResultado    RevisaoResultado? @map("revisao_resultado")
  revisadoEm          DateTime?         @map("revisado_em")
  /// Equipe editou o texto de um evento importado: a importação não sobrescreve mais o conteúdo.
  editadoPelaEquipe   Boolean           @default(false) @map("editado_pela_equipe")
  sincronizadoEm      DateTime?         @map("sincronizado_em")

  organizer Organizer? @relation(fields: [organizerId], references: [id])
  category  Category?  @relation(fields: [categoriaId], references: [id])
  favorites  Favorite[]
  comments   Comment[]
  denuncias  Denuncia[]
  interacoes InteracaoEvento[]
  pedidos    PedidoContato[]

  @@unique([fonte, fonteInstancia, idExterno])
  @@map("events")
}

model Category {
  id       String  @id @default(cuid())
  nome     String  @unique
  slug     String  @unique
  /// Nome do ícone lucide (ex.: "Music").
  icone    String  @default("Sparkles")
  parentId String? @map("parent_id")
  ordem    Int     @default(0)

  parent        Category?  @relation("subcategorias", fields: [parentId], references: [id], onDelete: Restrict)
  subcategorias Category[] @relation("subcategorias")
  events        Event[]

  @@index([parentId])
  @@map("categories")
}

model Favorite {
  userId  String @map("user_id")
  eventId String @map("event_id")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@map("favorites")
}

model Comment {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  eventId  String   @map("event_id")
  texto    String
  nota     Int
  oculto   Boolean  @default(false)
  criadoEm DateTime @default(now()) @map("criado_em")

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reports   CommentReport[]
  denuncias Denuncia[]

  @@map("comments")
}

/// Denúncia de evento OU de comentário (CHECK no banco garante exatamente um alvo).
model Denuncia {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  eventId        String?        @map("event_id")
  commentId      String?        @map("comment_id")
  motivo         DenunciaMotivo
  texto          String?
  status         DenunciaStatus @default(aberta)
  criadoEm       DateTime       @default(now()) @map("criado_em")
  resolvidoEm    DateTime?      @map("resolvido_em")
  resolvidoPorId String?        @map("resolvido_por_id")
  /// descartar | despublicar | remover_comentario
  resolucao      String?

  user         User     @relation("denunciante", fields: [userId], references: [id], onDelete: Cascade)
  event        Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  comment      Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  resolvidoPor User?    @relation("resolvedor", fields: [resolvidoPorId], references: [id], onDelete: SetNull)

  @@unique([userId, eventId])
  @@unique([userId, commentId])
  @@index([status, criadoEm])
  @@map("denuncias")
}

model CommentReport {
  id        String   @id @default(cuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  motivo    String
  criadoEm  DateTime @default(now()) @map("criado_em")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_reports")
}

model AdSlot {
  id           String     @id @default(cuid())
  tipo         AdSlotTipo
  patrocinador String
  imagem       String
  link         String
  dataInicio   DateTime   @map("data_inicio")
  dataFim      DateTime   @map("data_fim")
  ativo        Boolean    @default(false)
  /// Contados no servidor: exibição ao renderizar, clique em /api/anuncios/[id].
  exibicoes    Int        @default(0)
  cliques      Int        @default(0)

  @@map("ad_slots")
}

model Empresa {
  id              String            @id @default(cuid())
  userId          String            @unique @map("user_id")
  razaoSocial     String            @map("razao_social")
  cnpj            String            @unique
  status          StatusVerificacao @default(pendente)
  dataVerificacao DateTime?         @map("data_verificacao")
  criadoEm        DateTime          @default(now()) @map("criado_em")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pedidos  PedidoContato[]

  @@map("empresas")
}

/// Interação anônima com um evento. Sem nome, e-mail ou id de usuário.
model InteracaoEvento {
  id          String        @id @default(cuid())
  eventoId    String        @map("evento_id")
  tipo        TipoInteracao
  data        DateTime      @default(now())
  categoria   String
  bairro      String        @default("")
  cidade      String        @default("")
  faixaEtaria FaixaEtaria?  @map("faixa_etaria")
  /// Hash só para contar pessoas distintas dentro do servidor. Não entra em resposta nem em CSV.
  coorte      String?

  evento Event @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@index([data])
  @@index([eventoId, data])
  @@index([categoria, data])
  @@map("interacoes_evento")
}

model PedidoContato {
  id        String   @id @default(cuid())
  empresaId String   @map("empresa_id")
  eventoId  String   @map("evento_id")
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  evento  Event   @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@index([empresaId, eventoId])
  @@map("pedidos_contato")
}

model AdminLog {
  id        String   @id @default(cuid())
  autorId   String?  @map("autor_id")
  /// Nome de quem agiu no momento da ação; fica mesmo se a conta for excluída.
  autorNome String   @map("autor_nome")
  acao      String
  alvoTipo  String   @map("alvo_tipo")
  alvoId    String?  @map("alvo_id")
  detalhes  Json?
  criadoEm  DateTime @default(now()) @map("criado_em")

  autor User? @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([criadoEm])
  @@index([autorId])
  @@index([acao])
  @@map("admin_logs")
}
