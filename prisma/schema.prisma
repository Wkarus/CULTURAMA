generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserTipo {
  comum
  organizador
  admin
  moderador
}

enum TipoDocumento {
  CPF
  CNPJ
}

enum StatusVerificacao {
  pendente
  aprovado
  rejeitado
}

enum EventFonte {
  interno
  ticketmaster
}

enum RestricaoIdade {
  livre
  doze
  quatorze
  dezesseis
  dezoito
}

enum EventStatus {
  rascunho
  publicado
  cancelado
  adiado
  em_revisao
}

enum RevisaoResultado {
  recusado
  ajuste
}

enum AdSlotTipo {
  banner_home
  banner_categoria
  destaque_evento
}

model User {
  id                  String    @id @default(cuid())
  nome                String
  email               String    @unique
  senhaHash           String?   @map("senha_hash")
  tipo                UserTipo  @default(comum)
  interesses          String[]
  dataNascimento      DateTime? @map("data_nascimento")
  aceitePrivacidadeEm DateTime? @map("aceite_privacidade_em")
  criadoEm            DateTime  @default(now()) @map("criado_em")

  organizer Organizer?
  favorites Favorite[]
  comments  Comment[]
  commentReports CommentReport[]
  adminLogs      AdminLog[]

  @@map("users")
}

model Organizer {
  id                String             @id @default(cuid())
  userId            String             @unique @map("user_id")
  nomeEmpresa       String             @map("nome_empresa")
  documento         String
  tipoDocumento     TipoDocumento      @map("tipo_documento")
  statusVerificacao StatusVerificacao  @default(pendente) @map("status_verificacao")
  dataVerificacao   DateTime?          @map("data_verificacao")
  documentoUrl      String             @map("documento_url")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]

  @@map("organizers")
}

model Event {
  id             String         @id @default(cuid())
  organizerId    String?        @map("organizer_id")
  fonte          EventFonte
  idExterno      String?        @unique @map("id_externo")
  titulo         String
  descricao      String
  categoriaId    String?        @map("categoria_id")
  dataHora       DateTime       @map("data_hora")
  endereco       String
  latitude       Float
  longitude      Float
  imagemCapa     String?        @map("imagem_capa")
  linkIngresso   String?        @map("link_ingresso")
  gratuito       Boolean        @default(false)
  tags           String[]
  restricaoIdade RestricaoIdade @map("restricao_idade")
  linkSaibaMais  String?        @map("link_saiba_mais")
  notaAdmin      String?        @map("nota_admin")
  status         EventStatus    @default(rascunho)
  destaque       Boolean        @default(false)
  /// Motivo de recusa ou pedido de ajuste da revisão; aparece para o organizador em /conta/eventos.
  mensagemOrganizador String?           @map("mensagem_organizador")
  revisaoResultado    RevisaoResultado? @map("revisao_resultado")
  revisadoEm          DateTime?         @map("revisado_em")

  organizer Organizer? @relation(fields: [organizerId], references: [id])
  category  Category?  @relation(fields: [categoriaId], references: [id])
  favorites Favorite[]
  comments  Comment[]

  @@map("events")
}

model Category {
  id       String  @id @default(cuid())
  nome     String  @unique
  slug     String  @unique
  /// Nome do ícone lucide (ex.: "Music").
  icone    String  @default("Sparkles")
  parentId String? @map("parent_id")
  ordem    Int     @default(0)

  parent        Category?  @relation("subcategorias", fields: [parentId], references: [id], onDelete: Restrict)
  subcategorias Category[] @relation("subcategorias")
  events        Event[]

  @@index([parentId])
  @@map("categories")
}

model Favorite {
  userId  String @map("user_id")
  eventId String @map("event_id")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@map("favorites")
}

model Comment {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  eventId  String   @map("event_id")
  texto    String
  nota     Int
  oculto   Boolean  @default(false)
  criadoEm DateTime @default(now()) @map("criado_em")

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reports CommentReport[]

  @@map("comments")
}

model CommentReport {
  id        String   @id @default(cuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  motivo    String
  criadoEm  DateTime @default(now()) @map("criado_em")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_reports")
}

model AdSlot {
  id           String     @id @default(cuid())
  tipo         AdSlotTipo
  patrocinador String
  imagem       String
  link         String
  dataInicio   DateTime   @map("data_inicio")
  dataFim      DateTime   @map("data_fim")
  ativo        Boolean    @default(false)

  @@map("ad_slots")
}

model AdminLog {
  id        String   @id @default(cuid())
  autorId   String?  @map("autor_id")
  /// Nome de quem agiu no momento da ação; fica mesmo se a conta for excluída.
  autorNome String   @map("autor_nome")
  acao      String
  alvoTipo  String   @map("alvo_tipo")
  alvoId    String?  @map("alvo_id")
  detalhes  Json?
  criadoEm  DateTime @default(now()) @map("criado_em")

  autor User? @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([criadoEm])
  @@index([autorId])
  @@index([acao])
  @@map("admin_logs")
}
