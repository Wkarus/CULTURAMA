# Pooler do Supabase (Connect → ORMs → Prisma). Troque [YOUR-PASSWORD].
DATABASE_URL="postgresql://postgres.qvwejrfmjvsuwfrqvgdb:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.qvwejrfmjvsuwfrqvgdb:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Auth.js — gere com: npx auth secret
AUTH_SECRET=""

# E-mail da sua conta no Culturama. No próximo login essa conta vira admin (Fase 4).
# Depois rode: npm run db:admin  (ou só saia e entre de novo)
ADMIN_EMAIL=""

# E-mail (Resend). Sem RESEND_API_KEY o cadastro segue e o aviso só aparece no log do servidor.
# EMAIL_REMETENTE ex.: "Culturama <onboarding@resend.dev>"
# EMAIL_MODO_TESTE=true manda tudo para ADMIN_EMAIL, com o assunto prefixado.
RESEND_API_KEY=""
EMAIL_REMETENTE=""
EMAIL_MODO_TESTE=""

# Google OAuth (console.cloud.google.com)
# URI de redirecionamento: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Supabase (Storage entra depois; o upload da Fase 1 usa pasta local)
NEXT_PUBLIC_SUPABASE_URL="https://qvwejrfmjvsuwfrqvgdb.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Ticketmaster Discovery API (Fase 2). Sem chave o cron avisa e a listagem usa só eventos internos.
TICKETMASTER_API_KEY=""
TICKETMASTER_CITY="São Paulo"
# Domínios extras aceitos pelo proxy /api/imagem (separados por vírgula). Ticketmaster e o Supabase acima já entram.
IMAGEM_DOMINIOS=""
CRON_SECRET=""

# Mapas Culturais (API pública, sem chave). Uma instância por entrada: Nome|URL base|Fuso (fuso opcional, padrão America/Sao_Paulo).
# Separe com ";". O nome aparece no site como "Fonte: <nome>". Para acrescentar outra instância, basta incluir aqui.
# "|basico" no fim = só dados factuais (sem imagem e sem descrição da fonte), para fonte ainda sem autorização formal.
MAPAS_CULTURAIS_INSTANCIAS="CulturAZ — Prefeitura de Santo André|https://culturaz.santoandre.sp.gov.br|America/Sao_Paulo;SP Cultura|https://spcultura.prefeitura.sp.gov.br;Mapa da Cultura|https://mapa.cultura.gov.br;Mapa Cultural da Paraíba|https://mapacultural.pb.gov.br|America/Recife"
# Região (opcional): vazio = Brasil todo; o limite por distância fica com o usuário, no Perto de mim.
# Para restringir: UFs separadas por vírgula ("SP,RJ") e/ou raio "lat,lng,km" com ponto decimal (com os dois, vale a interseção).
# Com filtro ligado, local sem estado (ou sem coordenada, no caso do raio) fica de fora.
MAPAS_CULTURAIS_UFS=""
MAPAS_CULTURAIS_RAIO=""
# Janela de importação e educação com a API (pausa entre chamadas, timeout por chamada, retentativas com backoff).
MAPAS_CULTURAIS_DIAS="60"
MAPAS_CULTURAIS_PAUSA_MS="1000"
MAPAS_CULTURAIS_TIMEOUT_MS="20000"
MAPAS_CULTURAIS_TENTATIVAS="3"
# Máximo de endereços sem coordenada geocodificados por instância a cada rodada (Nominatim/OSM, 1 por segundo).
MAPAS_CULTURAIS_GEOCODE_MAX="25"
# Contato que vai no User-Agent "CulturamaBot/1.0 (+contato)" (URL ou e-mail da equipe). O User-Agent não é configurável.
MAPAS_CULTURAIS_CONTATO=""

# Google Maps (Fase 3). Ative Maps JavaScript API e Directions API no Cloud Console.
# A chave pública vai no mapa; a privada (opcional) vale para /api/rotas. Sem chave o mapa mostra o aviso.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_API_KEY=""
# Map ID do Cloud (vetorial / 3D). Sem isso usamos DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# Cadastro de organizador. true = não consulta a BrasilAPI; aceita CPF/CNPJ com dígito verificador e deixa o pedido pendente.
ORGANIZADOR_MODO_TESTE=""
# Culturama Insights. true = painel com dados fictícios em memória, sem gravar no banco.
INSIGHTS_MODO_DEMO=""
